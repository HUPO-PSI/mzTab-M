# Build artifacts
*.jar

# Antora site output
/build/

# Node.js dependencies (Antora + extensions)
/node_modules/
/package-lock.json
/.npm-cache/

# Antora content cache
/.cache/

# Temporary files
/tmp/

# jmzTab-m CLI conversion output (written next to the input by --fromJson)
*.json.mztab

.DS_Store

*.pyc
__pycache__/

# Specification PDF/DOCX are generated by build-docs.sh and copied into the
# Antora attachments folder by CI (or ./build-site.sh --with-spec). They are
# committed only on release documentation branches (vX.Y).
/docs/mztabm/modules/ROOT/attachments/mzTab_format_specification_*
/specification_documents/output/
